%% erlang_camunda_framework — workspace rebar.config
%%
%% This is a library repo. The four 'camunda_lN' apps are rebar deps
%% that any butler_server service includes in its own rebar.config.
%%
%% To use a single layer in your service:
%%   {deps, [{camunda_l2, {git, "git@github.com:greyorange/erlang_camunda_framework.git",
%%                             {branch, "main"}}}]}.
%%
%% To use all layers:
%%   {deps, [{camunda_l1, ...}, {camunda_l2, ...}, {camunda_l3, ...}, {camunda_l4, ...}]}.

{erl_opts, [debug_info]}.

{project_plugins, [rebar3_elvis_plugin]}.

{profiles, [
    {dev,  [{deps, [{meck, "0.9.2"}]}]},
    {test, [{deps, [{meck, "0.9.2"}]},
            {ct_opts, [{sys_config, "config/test.sys.config"}]}]}
]}.

{apps, [
    camunda_l1,
    camunda_l2,
    camunda_l3,
    camunda_l4
]}.

{elvis, [{config, "elvis.config"}]}.
