      </bpmn:extensionElements>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_F" name="More Bins In Batch? (Inner Loop)" default="Flow_37">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AnyMorePickInstructions" name="Any More Pick Instructions? (Connector Operation)" zeebe:modelerTemplate="io.greyorange.pickvanillademo.ButlerServer.v1" zeebe:modelerTemplateVersion="1">
