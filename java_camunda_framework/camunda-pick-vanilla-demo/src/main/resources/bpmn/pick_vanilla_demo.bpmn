      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_AnyMoreBinsInBatch" name="Any More Bins In Batch? (Connector Operation)" zeebe:modelerTemplate="io.greyorange.pickvanillademo.ButlerServer.v1" zeebe:modelerTemplateVersion="1">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.greyorange.pickvanillademo:butler-server:1" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="operation" value="any_more_bins_in_batch" />
          <zeebe:header key="resultExpression" value="={ more_bins_in_batch: response.more_bins_in_batch, phase: response.phase }" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=pps_id" target="pps_id" />
