        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=pps_id" target="pps_id" />
          <zeebe:output source="=print_awaited" target="print_awaited" />
          <zeebe:output source="=phase" target="phase" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_E" name="Print Awaited?" default="Flow_33">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_WaitForPrintoutConfirm" name="Wait For Printout Confirm (Script)">
