      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_G" name="More Pick Instructions? (Outer Loop)" default="Flow_41">
