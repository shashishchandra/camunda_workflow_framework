      <bpmn:outgoing>Flow_41</bpmn:outgoing>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutoDestClear" name="Auto Dest Clear (Connector Operation)" zeebe:modelerTemplate="io.greyorange.pickvanillademo.ButlerServer.v1" zeebe:modelerTemplateVersion="1">
      <bpmn:extensionElements>
