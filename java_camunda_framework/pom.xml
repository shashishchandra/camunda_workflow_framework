<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent POM for all camunda layer starters -->
    <groupId>com.greyorange.camunda</groupId>
    <artifactId>java-camunda-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>camunda-l1-starter</module>
        <module>camunda-l2-starter</module>
        <module>camunda-l3-starter</module>
        <!-- camunda-l4-starter and example are not yet buildable Maven modules
             (no pom.xml of their own — L4/L5 are still in design, not implemented;
             see the L4/L5 slide). Re-add here once they get a pom.xml. -->
        <module>camunda-l1-l3-demo</module>
        <module>camunda-pick-vanilla-demo</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <spring-boot.version>3.2.0</spring-boot.version>
        <zeebe.version>8.4.0</zeebe.version>
        <kafka.version>3.6.0</kafka.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.camunda</groupId>
                <artifactId>spring-zeebe-starter</artifactId>
                <version>${zeebe.version}</version>
            </dependency>
            <!-- Override spring-boot-dependencies' 1.18.30, too old to run its annotation
                 processor on a JDK this new; without this override, @Getter/@Setter/etc.
                 silently produce no accessors and every caller fails with "cannot find symbol". -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.42</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
