<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.greyorange.camunda</groupId>
        <artifactId>java-camunda-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>camunda-l1-l3-demo</artifactId>
    <packaging>jar</packaging>
    <name>Demo: Rack Arrival + Master PPTL Press (L1-L3 wired to Zeebe)</name>
    <description>
        Standalone Spring Boot app demonstrating the L1-L3 starters end to end:
        two Zeebe job workers (L3) delegate to WorkflowSagaBase sagas (L2) that
        persist checkpoints via a JPA entity (L1). The worker (L3) is the entry
        point that holds L1 and L2 beneath it — this module demos all three,
        not L2 in isolation. Deploy pick_demo_rack_pptl.bpmn to a local Zeebe
        broker via Camunda Modeler, run this app, start an instance, and watch
        it execute live in Operate.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.greyorange.camunda</groupId>
            <artifactId>camunda-l1-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.greyorange.camunda</groupId>
            <artifactId>camunda-l2-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.greyorange.camunda</groupId>
            <artifactId>camunda-l3-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>camunda-l1-l3-demo</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
